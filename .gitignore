# Public source allowlist: local research and development files stay private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/app/
!/docs/
!/.github/
!/tools/
/app/*
!/app/build.gradle.kts
!/app/src/
/tools/*
!/tools/fixtures/
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/local.properties
**/__pycache__/
**/*.pyc
**/*.apk
**/*.aab
**/*.jks
**/*.keystore
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.*
**/*.log
**/*.hprof
